+function Rows(props: { ctx: Ctx; tree: TestNode }) {
+  const [closed, setClosed] = createSignal(new Set<string>());
+  const [top, setTop] = createSignal(0);
+  const [height, setHeight] = createSignal(800);
+  let scroller!: HTMLDivElement;
+  const rows = createMemo(() => flatten(props.tree, closed(), props.ctx.state.filter));
+  const shown = createMemo(() => {
+    const first = Math.max(0, Math.floor(top() / ROW) - OVERSCAN);
+    const last = Math.min(rows().length, Math.ceil((top() + height()) / ROW) + OVERSCAN);
+    return rows().slice(first, last);
+  });
+  const toggle = (key: string) => {
+    const next = new Set(closed());
+    if (!next.delete(key)) next.add(key);
+    setClosed(next);
+  };
+  const ro = new ResizeObserver(() => setHeight(scroller.clientHeight));
+  onCleanup(() => ro.disconnect());
+  return (
+    <div
+      ref={(e) => {
+        scroller = e;
+        ro.observe(e);
+      }}
+      class="min-h-0 flex-1 overflow-auto p-2"
+      onScroll={() => setTop(scroller.scrollTop)}
+    >
+      <div
+        role="tree"
+        data-testid="tree"
+        data-rows={rows().length}
+        style={`position:relative;height:${rows().length * ROW}px`}
+      >
+        <For each={shown()} keyed={(r) => r.node.key}>
+          {(r) => (
+            <Node
+              row={r()}
+              ctx={props.ctx}
+              open={!closed().has(r().node.key)}
+              toggle={() => toggle(r().node.key)}
+            />
+          )}
+        </For>
+      </div>
+    </div>
   );
