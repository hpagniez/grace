+    #[test]
+    fn a_window_pauses_only_when_gpui_neither_draws_nor_asks_again() {
+        let frames = FrameDemand::default();
+
+        frames.begin_tick();
+        frames.mark_presented();
+        assert!(!frames.end_tick(), "a frame that drew keeps it running");
+
+        frames.begin_tick();
+        frames.wake();
+        assert!(!frames.end_tick(), "a wake during the paint keeps it running");
+
+        frames.begin_tick();
+        assert!(frames.end_tick(), "an idle paint pauses it");
+        assert!(frames.is_paused());
+
+        frames.wake();
+        assert!(!frames.is_paused(), "a wake unpauses it");
+    }
 }
