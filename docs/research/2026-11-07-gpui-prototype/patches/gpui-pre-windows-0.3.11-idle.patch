+/// Whether GPUI wants frames from a window, so that the vsync thread can stop
+/// invalidating it, and sleep once every window is idle, as the macOS Metal
+/// display link pauses.
+///
+/// A window pauses after a `WM_PAINT` in which GPUI neither drew, presented,
+/// nor asked for another frame. GPUI's frame waker (called when a view
+/// becomes dirty, on `on_next_frame`, and when a throttled frame must be
+/// retried) unpauses it and wakes the vsync thread.
+///
+/// `begin_tick`, `end_tick` and `wake` run on the main thread; the vsync
+/// thread only reads `is_paused`.
+#[derive(Default)]
+pub(crate) struct FrameDemand {
+    /// GPUI asked for a frame since the current paint began.
+    woken: AtomicBool,
+    /// The current paint drew or presented a frame.
+    presented: AtomicBool,
+    /// The vsync thread leaves this window alone until the next wake.
+    paused: AtomicBool,
+}
+
+impl FrameDemand {
+    pub(crate) fn wake(&self) {
+        self.woken.store(true, Ordering::SeqCst);
+        self.paused.store(false, Ordering::SeqCst);
+        VSYNC_GATE.open();
+    }
+
+    pub(crate) fn mark_presented(&self) {
+        self.presented.store(true, Ordering::SeqCst);
+    }
+
+    pub(crate) fn begin_tick(&self) {
+        self.woken.store(false, Ordering::SeqCst);
+        self.presented.store(false, Ordering::SeqCst);
+    }
+
+    /// Ends a paint, pausing the window if GPUI neither presented nor asked for
+    /// another frame during it. Returns whether it paused.
+    pub(crate) fn end_tick(&self) -> bool {
+        let pause = !self.presented.load(Ordering::SeqCst) && !self.woken.load(Ordering::SeqCst);
+        if pause {
+            self.paused.store(true, Ordering::SeqCst);
+        }
+        pause
+    }
+
+    pub(crate) fn is_paused(&self) -> bool {
+        self.paused.load(Ordering::SeqCst)
+    }
+}
+
+/// Where the vsync thread sleeps while no window wants frames. One per
+/// process, like the vsync thread.
+pub(crate) static VSYNC_GATE: VSyncGate = VSyncGate {
+    opened: Mutex::new(false),
+    condvar: Condvar::new(),
+};
+
+pub(crate) struct VSyncGate {
+    opened: Mutex<bool>,
+    condvar: Condvar,
+}
+
+impl VSyncGate {
+    /// Wakes the vsync thread if it sleeps, or keeps its next wait from sleeping.
+    pub(crate) fn open(&self) {
+        *self.opened.lock().unwrap_or_else(|e| e.into_inner()) = true;
+        self.condvar.notify_all();
+    }
+
+    /// Sleeps while `idle` holds and nothing opened the gate since the last
+    /// wait. A wake changes what `idle` reads before it opens the gate, so it
+    /// is never lost. `idle` must not wait on the main thread.
+    pub(crate) fn wait_while(&self, idle: impl Fn() -> bool) {
+        let mut opened = self.opened.lock().unwrap_or_else(|e| e.into_inner());
+        while !*opened && idle() {
+            opened = self.condvar.wait(opened).unwrap_or_else(|e| e.into_inner());
+        }
+        *opened = false;
+    }
+}
+
 const VSYNC_INTERVAL_THRESHOLD: Duration = Duration::from_millis(1);
 const DEFAULT_VSYNC_INTERVAL: Duration = Duration::from_micros(16_666); // ~60Hz
 
