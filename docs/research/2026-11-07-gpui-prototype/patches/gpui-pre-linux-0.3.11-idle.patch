+/// Whether GPUI wants frames from a window's refresh loop, so that the loop
+/// can stop while the window is idle, as the macOS Metal display link does.
+///
+/// The loop stops after a tick in which GPUI neither drew, presented, nor
+/// asked for another frame. GPUI's frame waker (called when a view becomes
+/// dirty, on `on_next_frame`, and when a throttled frame must be retried)
+/// restarts it through the client's `frame_ping`.
+pub(crate) struct FrameDemand {
+    /// GPUI asked for a frame since the current tick began.
+    woken: Cell<bool>,
+    /// The current tick drew or presented a frame.
+    presented: Cell<bool>,
+    /// The refresh loop is stopped, so a wake must restart it.
+    paused: Cell<bool>,
+    ping: Ping,
+}
+
+impl FrameDemand {
+    fn new(ping: Ping) -> Self {
+        Self {
+            woken: Cell::new(false),
+            presented: Cell::new(false),
+            paused: Cell::new(false),
+            ping,
+        }
+    }
+
+    pub(crate) fn wake(&self) {
+        self.woken.set(true);
+        if self.paused.get() {
+            self.ping.ping();
+        }
+    }
+
+    pub(crate) fn mark_presented(&self) {
+        self.presented.set(true);
+    }
+
+    pub(crate) fn begin_tick(&self) {
+        self.woken.set(false);
+        self.presented.set(false);
+    }
+
+    /// Ends a tick, pausing if GPUI neither presented nor asked for another
+    /// frame during it. Returns whether it paused.
+    pub(crate) fn end_tick(&self) -> bool {
+        let pause = !self.presented.get() && !self.woken.get();
+        self.paused.set(pause);
+        pause
+    }
+
+    /// Takes a pending wake of a paused loop: returns whether the loop must restart.
+    pub(crate) fn take_wake(&self) -> bool {
+        let restart = self.paused.get() && self.woken.get();
+        if restart {
+            self.paused.set(false);
+        }
+        restart
+    }
+
+    /// Forgets a pause, when the window is hidden and the loop is restarted by showing it.
+    pub(crate) fn unpause(&self) {
+        self.paused.set(false);
+    }
+}
