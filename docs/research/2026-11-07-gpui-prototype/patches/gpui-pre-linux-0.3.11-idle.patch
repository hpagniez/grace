+#[cfg(test)]
+mod frame_demand_tests {
+    use super::FrameDemand;
+
+    #[test]
+    fn the_loop_pauses_only_when_gpui_neither_draws_nor_asks_again() {
+        let (ping, _source) = calloop::ping::make_ping().unwrap();
+        let frames = FrameDemand::new(ping);
+
+        frames.begin_tick();
+        frames.mark_presented();
+        assert!(!frames.end_tick(), "a tick that drew keeps it running");
+
+        frames.begin_tick();
+        frames.wake();
+        assert!(!frames.end_tick(), "a wake during the tick keeps it running");
+
+        frames.begin_tick();
+        assert!(frames.end_tick(), "an idle tick pauses it");
+        assert!(!frames.take_wake(), "nothing to restart before a wake");
+
+        frames.wake();
+        assert!(frames.take_wake(), "a wake restarts a paused loop");
+        assert!(!frames.take_wake(), "once");
+    }
+}
