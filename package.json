{
  "name": "grace",
  "version": "1.0.0-rc.9",
  "private": true,
  "description": "Free desktop test-suite runner for Karate",
  "keywords": [],
  "license": "MIT",
  "author": "Tusquito",
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release": "electron-forge release",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "npm run package && node --no-warnings bench/bench.mjs",
    "package:gpui": "node scripts/package-gpui.mjs",
    "bench:gpui": "node scripts/package-gpui.mjs --no-zip && node --no-warnings bench/bench.mjs --b out/gpui/Grace-win32-x64/Grace.exe",
    "e2e": "npm run package && npx electron --version && playwright test",
    "screens": "npm run package && npx electron --version && playwright test --config playwright.screens.config.ts screens.shots",
    "screens:readme": "npm run package && npx electron --version && playwright test --config playwright.screens.config.ts readme.shots",
    "vendor": "node scripts/fetch-vendor.mjs",
    "vendor:bump": "node scripts/bump-vendor.mjs",
    "cargo:bump": "node scripts/bump-cargo.mjs",
    "fixtures": "node scripts/capture-fixtures.mjs",
    "icon": "node scripts/make-icon.mjs"
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@solidjs/web": "2.0.0-rc.19",
    "lucide": "1.70.0",
    "solid-js": "2.0.0-rc.19"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.65.0",
    "@solidjs/testing-library": "1.0.0-rc.2",
    "@solidjs/vite-plugin": "3.0.0-next.52",
    "@tailwindcss/vite": "4.3.5",
    "electron": "45.2.3",
    "jsdom": "30.1.3",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@electron/asar": {
      "glob": "14.0.3",
      "minimatch": "11.0.3"
    }
  },
  "productName": "Grace"
}
