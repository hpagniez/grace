{
  "compilerOptions": {
    "target": "ESNext",
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "strict": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web"
  },
  "include": ["src/**/*", "scripts/**/*", "test/**/*", "e2e/**/*", "*.ts", "*.mts"]
}
